<!DOCTYPE html>
<html lang="nb">
<head>
<meta charset="utf-8">
<title>{{ doc_title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  @page {
    size: A4;
    margin: 20mm 20mm 18mm 20mm;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html, body {
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 10.5pt;
    line-height: 1.62;
    color: #1e293b;
    background: #ffffff;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  
  .letter-title {
    font-size: 17pt;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #323b4c;
    margin-bottom: 2px;
  }
  .letter-subtitle {
    font-size: 11pt;
    font-weight: 500;
    color: #64748b;
    margin-bottom: 18px;
  }
  .recipient {
    font-size: 9.8pt;
    color: #334155;
    margin-bottom: 16px;
    line-height: 1.45;
  }
  .salutation {
    font-size: 10.5pt;
    font-weight: 600;
    color: #0f172a;
    margin-bottom: 12px;
  }
  p {
    margin-bottom: 12px;
    text-align: justify;
    text-justify: inter-word;
  }
  .closing {
    margin-top: 18px;
    font-weight: 500;
    color: #0f172a;
  }
  .signature {
    margin-top: 14px;
    font-size: 11.5pt;
    font-weight: 700;
    color: #323b4c;
  }
  .contact-footer {
    margin-top: 6px;
    font-size: 9.2pt;
    color: #64748b;
  }
  strong {
    font-weight: 600;
    color: #0f172a;
  }

  @media screen {
    body {
      max-width: 210mm;
      margin: 20px auto;
      padding: 20mm 20mm;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      border-radius: 4px;
    }
  }

  @media print {
    html, body {
      background: #ffffff;
      padding: 0;
      max-width: none;
    }
  }
</style>
</head>
<body>
  {{ body }}
</body>
</html>