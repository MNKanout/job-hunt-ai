{
  "mcpServers": {
    "jobs": {
      "type": "http",
      "url": "https://mcp.jobhunt.syrwegian.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/playwright_mcp.py", "--output-dir", "/tmp/playwright-mcp"]
    },
    "finder1": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/playwright_mcp.py", "--lane", "finder1", "--headless", "--isolated", "--output-dir", "/tmp/playwright-mcp"]
    },
    "finder2": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/playwright_mcp.py", "--lane", "finder2", "--headless", "--isolated", "--output-dir", "/tmp/playwright-mcp"]
    },
    "finder3": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/playwright_mcp.py", "--lane", "finder3", "--headless", "--isolated", "--output-dir", "/tmp/playwright-mcp"]
    },
    "print": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/playwright_mcp.py", "--lane", "print", "--headless", "--isolated", "--output-dir", "/tmp/playwright-mcp"]
    }
  }
}
